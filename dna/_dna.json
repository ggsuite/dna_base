{
  // dna_base is a DNA package: dna/ is authored by hand and is the last
  // layer of its own instantiation. "role": "dna" is also what makes this
  // package usable as a layer at all — a dna/ folder alone does not.
  "version": 1,
  "role": "dna",

  // The root of the tree: no parent DNAs.
  "layers": [],

  // Imported into CLAUDE.md's managed block — every guide plus the
  // project structure is mandatory reading for Claude at session start.
  "claude": {
    "claudeMdInclude": ["doc/99-guides/en", "doc/file-structure.md"]
  }
}
