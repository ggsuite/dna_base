{
  "name": "@tssuite/base-dna",
  "version": "1.1.1",
  "description": "The base DNA of our projects - shared configs, docs, scripts and agent skills inherited by every repository via gg_dna.",
  "keywords": [
    "dna",
    "gg_dna",
    "conventions",
    "scaffolding"
  ],
  "homepage": "https://github.com/ggsuite/base_dna",
  "bugs": "https://github.com/ggsuite/base_dna/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggsuite/base_dna.git"
  },
  "type": "module",
  "files": [
    "dna",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-version": "dart run scripts/sync_version.dart",
    "test:dart": "dart test",
    "test": "pnpm run sync-version && pnpm run test:dart",
    "prepublishOnly": "pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6"
  }
}
